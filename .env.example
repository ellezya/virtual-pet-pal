# Copy this file to .env and fill in real values. Never commit .env.

# ── Supabase ────────────────────────────────────────────────────────────────
# After Phase 3: update these to point to SpedZen's Supabase instance.
VITE_SUPABASE_URL="https://<project-id>.supabase.co"
VITE_SUPABASE_PUBLISHABLE_KEY="sb_publishable_<key>"
VITE_SUPABASE_PROJECT_ID="<project-id>"

# ── Platform admin ───────────────────────────────────────────────────────────
# Temporary: email of the platform admin user.
# Phase 5 will replace this with a user_roles DB lookup (platform_admin role).
VITE_ADMIN_EMAIL="founder@lalalola.app"

# ── Teacher beta access ──────────────────────────────────────────────────────
# Temporary: email domain that receives automatic teacher beta access.
# Phase 4 will replace this with a query to the platform_config DB table.
VITE_APPROVED_TEACHER_DOMAIN="twincitiesacademy.org"

# ── Origin URLs ──────────────────────────────────────────────────────────────
VITE_CONSUMER_ORIGIN="https://lalalola.app"
VITE_ADMIN_ORIGIN="https://school.lalalola.app"
